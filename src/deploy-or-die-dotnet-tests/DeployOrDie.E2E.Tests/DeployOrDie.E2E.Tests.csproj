<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .NET bindings follow the Node release. They are one version behind. -->
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.13.0" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" Version="1.62.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
